# Copy to .env for your deployment service manager; do not commit real secrets.
HOST=127.0.0.1
PORT=8787
KRABAK_DATA_DIR=/var/lib/krabak-remote
KRABAK_TRUST_PROXY=1
KRABAK_PUBLIC_ORIGIN=https://remote.example.ac.th
# Use development origin only during local testing:
# KRABAK_DEV_ORIGIN=http://localhost:5173
KRABAK_STUN_URL=stun:stun.l.google.com:19302
# Recommended for connections across strict NAT / mobile networks:
# KRABAK_TURN_URL=turn:turn.example.ac.th:3478
# Use coturn use-auth-secret / static-auth-secret. The server generates short-lived HMAC credentials.
# KRABAK_TURN_SECRET=long-random-secret-shared-with-coturn
