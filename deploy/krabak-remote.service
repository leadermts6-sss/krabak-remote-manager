[Unit]
Description=KRABAK Remote Manager (PWA + WebRTC signaling)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=krabak-remote
Group=krabak-remote
WorkingDirectory=/opt/krabak-remote-manager/current
EnvironmentFile=/etc/krabak-remote/remote.env
ExecStart=/opt/node-v26.13.1-linux-x64/bin/node /opt/krabak-remote-manager/current/server/index.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/krabak-remote
UMask=0077
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
