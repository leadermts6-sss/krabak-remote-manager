<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>KRABAK.RemoteAgent</AssemblyName>
    <RootNamespace>KRABAK.RemoteAgent</RootNamespace>
    <AgentChannel Condition="'$(AgentChannel)' == ''">Development</AgentChannel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AgentChannel)' == 'Production'">
    <DefineConstants>$(DefineConstants);AGENT_PRODUCTION</DefineConstants>
  </PropertyGroup>
</Project>
